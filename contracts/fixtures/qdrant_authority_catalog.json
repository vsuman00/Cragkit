        "(ever_published AND (EXISTS ( SELECT 1\n   FROM cragkit_qdrant.documents document\n  WHERE (((document.tenant_id)::text = (generations.tenant_id)::text) AND ((document.collection)::text = (generations.collection)::text) AND ((document.document_id)::text = (generations.document_id)::text)))))",
