{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_revision": {
      "pattern": "^[^\\u0000]*$",
      "title": "Authorization Revision",
      "type": "string"
    },
    "grant_ids": {
      "default": [],
      "items": {
        "pattern": "^[^\\u0000]*$",
        "type": "string"
      },
      "maxLength": 64,
      "title": "Grant Ids",
      "type": "array"
    },
    "principal_id": {
      "pattern": "^[^\\u0000]*$",
      "title": "Principal Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[^\\u0000]*$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "principal_id",
    "authorization_revision"
  ],
  "title": "TrustedScope",
  "type": "object"
}
