{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collection": {
      "pattern": "^[^\\u0000]*$",
      "title": "Collection",
      "type": "string"
    },
    "query": {
      "pattern": "^[^\\u0000]*$",
      "title": "Query",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[^\\u0000]*$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "search_hints": {
      "default": [],
      "items": {
        "pattern": "^[^\\u0000]*$",
        "type": "string"
      },
      "maxLength": 8,
      "title": "Search Hints",
      "type": "array"
    }
  },
  "required": [
    "query",
    "collection"
  ],
  "title": "ToolRequest",
  "type": "object"
}
