{
  "name": "cragkit",
  "version": "1.0.0-rc.2",
  "private": true,
  "license": "MIT",
  "author": "Vaibhav Suman",
  "description": "Native TypeScript retrieval with source-linked evidence, coverage estimates and execution diagnostics.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vsuman00/Cragkit.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://github.com/vsuman00/Cragkit#readme",
  "bugs": {"url": "https://github.com/vsuman00/Cragkit/issues"},
  "type": "module",
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./qdrant": {
      "types": "./dist/qdrant.d.ts",
      "import": "./dist/qdrant.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings.d.ts",
      "import": "./dist/embeddings.js"
    },
    "./reranking": {
      "types": "./dist/reranking.d.ts",
      "import": "./dist/reranking.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./packing": {
      "types": "./dist/packing.d.ts",
      "import": "./dist/packing.js"
    },
    "./assessment": {
      "types": "./dist/assessment.d.ts",
      "import": "./dist/assessment.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "import": "./dist/evidence.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "import": "./dist/execution.js"
    },
    "./planning": {
      "types": "./dist/planning.d.ts",
      "import": "./dist/planning.js"
    },
    "./corrective": {
      "types": "./dist/corrective.d.ts",
      "import": "./dist/corrective.js"
    },
    "./postgres-corrective": {
      "types": "./dist/postgres-corrective.d.ts",
      "import": "./dist/postgres-corrective.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./qdrant-source": {
      "types": "./dist/qdrant-source.d.ts",
      "import": "./dist/qdrant-source.js"
    },
    "./qdrant-corrective": {
      "types": "./dist/qdrant-corrective.d.ts",
      "import": "./dist/qdrant-corrective.js"
    },
    "./qdrant-publication": {
      "types": "./dist/qdrant-publication.d.ts",
      "import": "./dist/qdrant-publication.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "pg": "8.23.1",
    "tiktoken": "1.0.22",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "pg": "8.23.1",
    "tiktoken": "1.0.22"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "tiktoken": {
      "optional": true
    }
  }
}
